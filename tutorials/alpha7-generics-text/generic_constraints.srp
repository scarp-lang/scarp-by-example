// Numeric preserves the concrete number type; Comparable permits ordering.
pure funcra square<T: Numeric>(value: T) -> T {
    return value * value;
}
pure funcra maximum<T: Comparable>(left: T, right: T) -> T {
    if left > right { return left; }
    return right;
}

print(square(5), square(0.1d), square(1.5));
print(maximum((1, 3), (1, 9)));
print(square(bigint("10000000000")));
