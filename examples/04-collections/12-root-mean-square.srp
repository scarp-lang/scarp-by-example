// RMS measures signal magnitude per sample without changing its inputs.
bind balanced = [2.0, -2.0, 2.0, -2.0];
print("balanced", rms(balanced));

// The values at either edge are excluded from the selected window.
bind samples = [99.0, 3.0, 4.0, 0.0, 0.0, 99.0];
bind selected = window(samples, 1, 4);
print("window", rms(selected));

// Scaling avoids directly squaring a huge finite value.
print("finite", rms([1e308, -1e308]) == 1e308);
print("zero", rms([0.0, -0.0]));
